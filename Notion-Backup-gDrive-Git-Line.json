        "url": "=https://api.github.com/repos/{{ $('setEnvs').item.json.github_owner }}/{{ $('setEnvs').item.json.github_repo }}/contents/{{ encodeURIComponent($json.filePath) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
