    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract the important fields and compute file path\nconst item = $input.item.json;\n\n// Get title - try multiple locations\nlet title = 'Untitled';\ntry {\n  if (item.properties?.title?.title?.[0]?.plain_text) {\n    title = item.properties.title.title[0].plain_text;\n  } else if (item.properties?.Name?.title?.[0]?.plain_text) {\n    title = item.properties.Name.title[0].plain_text;\n  } else {\n    // Try any title-type property\n    for (const [key, val] of Object.entries(item.properties || {})) {\n      if (val.type === 'title' && val.title?.[0]?.plain_text) {\n        title = val.title[0].plain_text;\n        break;\n      }\n    }\n  }\n} catch(e) { title = item.id; }\n\n// Sanitize title for use as filename\nconst safeTitle = title\n  .replace(/[\\/\\\\:*?\"<>|]/g, '-')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst parentType = item.parent?.type || 'workspace';\nconst parentDbId = item.parent?.database_id?.replaceAll('-', '') || null;\nconst parentPageId = item.parent?.page_id?.replaceAll('-', '') || null;\n\nreturn {\n  json: {\n    id: item.id,\n    title: safeTitle,\n    originalTitle: title,\n    parentType: parentType,\n    parentDbId: parentDbId,\n    parentPageId: parentPageId,\n    lastEditedTime: item.last_edited_time,\n    url: item.url,\n    properties: item.properties\n  }\n};"
      },
