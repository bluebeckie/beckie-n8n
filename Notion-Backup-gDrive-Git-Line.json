      ],
      "id": "2c9bdcaf-b9bf-489c-98ad-db944e0d6bd1",
      "name": "Get DB Info (for folder name)",
      "credentials": {
        "notionApi": {
          "id": "2gAPhzbsQIvdY5Gi",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Both merged by position, so $input.all() gives [blocksItem, dbInfoItem]\n// entryData lives in Merge DB Data upstream\n\n// console.log(JSON.stringify($input.item.json));\n\nconst merged = $input.item.json;\nconst blocksData = merged.blockdata;  // Get Blocks 的結果\nconst dbInfo = merged.dbinfo;      // Get DB Info 的結果\nconst entryData = $('Enrich Entry with Properties').item.json;\n\n// Get DB title\nlet dbTitle = 'Unknown DB';\ntry {\n  dbTitle = dbInfo.title?.[0]?.plain_text || dbInfo.id;\n} catch(e) {}\nconst safeDbTitle = dbTitle.replace(/[\\/\\\\:*?\"<>|]/g, '-').trim();\n\n// Helper to extract property value as string\nfunction propToString(prop) {\n  if (!prop) return '';\n  switch(prop.type) {\n    case 'title': return prop.title?.map(t => t.plain_text).join('') || '';\n    case 'rich_text': return prop.rich_text?.map(t => t.plain_text).join('') || '';\n    case 'number': return prop.number?.toString() || '';\n    case 'select': return prop.select?.name || '';\n    case 'multi_select': return prop.multi_select?.map(s => s.name).join(', ') || '';\n    case 'status': return prop.status?.name || '';\n    case 'date': return prop.date?.start || '';\n    case 'checkbox': return prop.checkbox ? 'true' : 'false';\n    case 'url': return prop.url || '';\n    case 'email': return prop.email || '';\n    case 'phone_number': return prop.phone_number || '';\n    case 'people': return prop.people?.map(p => p.name).join(', ') || '';\n    case 'created_time': return prop.created_time || '';\n    case 'last_edited_time': return prop.last_edited_time || '';\n    case 'formula': return prop.formula?.string || prop.formula?.number?.toString() || prop.formula?.boolean?.toString() || '';\n    default: return JSON.stringify(prop);\n  }\n}\n\n// Blocks → Markdown\nfunction blockToMarkdown(block) {\n  const type = block.type;\n  const b = block[type];\n  if (!b) return ''; \n  const getText = (richText) => {\n    if (!richText) return '';\n    return richText.map(t => {\n      let text = t.plain_text || '';\n      if (t.annotations?.bold) text = `**${text}**`;\n      if (t.annotations?.italic) text = `*${text}*`;\n      if (t.annotations?.code) text = `\\`${text}\\``;\n      if (t.href) text = `[${text}](${t.href})`;\n      return text;\n    }).join('');\n  };\n  \n  switch(type) {\n    case 'paragraph': return getText(b.rich_text) + '\\n\\n';\n    case 'heading_1': return `# ${getText(b.rich_text)}\\n\\n`;\n    case 'heading_2': return `## ${getText(b.rich_text)}\\n\\n`;\n    case 'heading_3': return `### ${getText(b.rich_text)}\\n\\n`;\n    case 'bulleted_list_item': return `- ${getText(b.rich_text)}\\n`;\n    case 'numbered_list_item': return `1. ${getText(b.rich_text)}\\n`;\n    case 'to_do': return `- [${b.checked ? 'x' : ' '}] ${getText(b.rich_text)}\\n`;      \n    case 'quote': return `> ${getText(b.rich_text)}\\n\\n`;\n    // case 'callout':\n        // const icon = b.icon?.emoji || '💡';\n        // return `> ${icon} ${getText(b.rich_text)}\\n\\n`;\n    case 'code': return `\\`\\`\\`${b.language || ''}\\n${getText(b.rich_text)}\\n\\`\\`\\`\\n\\n`;\n    case 'divider': return `---\\n\\n`;\n    case 'image': {\n      const url = b.external?.url || b.file?.url || '';\n      return `![image](${url})\\n\\n`;\n    }\n    case 'bookmark': return `[${getText(b.caption) || b.url}](${b.url})\\n\\n`;\n    default: return '';\n  }\n}\n\n// YAML frontmatter from properties\nconst props = entryData.fullProperties || {};\nlet frontmatter = '---\\n';\nfor (const [key, val] of Object.entries(props)) {\n  const strVal = propToString(val).replace(/'/g, \"''\");\n  frontmatter += `${key}: '${strVal}'\\n`;\n}\nfrontmatter += `---\\n\\n`;\n\n// Body\nconst blocks = blocksData.results || [];\nlet body = '';\nfor (const block of blocks) {\n  body += blockToMarkdown(block);\n}\n\nconst md = frontmatter + `# ${entryData.title}\\n\\n` + (body || '_No content_\\n');\nconst filePath = `${safeDbTitle}/${entryData.title}.md`;\n\nreturn {\n  json: {\n    ...entryData,\n    dbTitle: safeDbTitle,\n    markdown: md,\n    filePath: filePath,\n    commitMessage: `backup: update ${safeDbTitle}/${entryData.title}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        512
      ],
