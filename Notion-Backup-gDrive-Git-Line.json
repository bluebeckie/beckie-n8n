    {
      "parameters": {
        "jsCode": "const pageData = $('Route by Parent Type').item.json;\nconst blocksData = $input.item.json;\n\nfunction blockToMarkdown(block) {\n  const type = block.type;\n  const b = block[type];\n  if (!b) return '';\n  \n  const getText = (richText) => {\n    if (!richText) return '';\n    return richText.map(t => {\n      let text = t.plain_text || '';\n      if (t.annotations?.bold) text = `**${text}**`;\n      if (t.annotations?.italic) text = `*${text}*`;\n      if (t.annotations?.code) text = `\\`${text}\\``;\n      if (t.href) text = `[${text}](${t.href})`;\n      return text;\n    }).join('');\n  };\n  \n  switch(type) {\n    case 'paragraph': return getText(b.rich_text) + '\\n\\n';\n    case 'heading_1': return `# ${getText(b.rich_text)}\\n\\n`;\n    case 'heading_2': return `## ${getText(b.rich_text)}\\n\\n`;\n    case 'heading_3': return `### ${getText(b.rich_text)}\\n\\n`;\n    case 'bulleted_list_item': return `- ${getText(b.rich_text)}\\n`;\n    case 'numbered_list_item': return `1. ${getText(b.rich_text)}\\n`;\n    case 'to_do': return `- [${b.checked ? 'x' : ' '}] ${getText(b.rich_text)}\\n`;\n    case 'toggle': return `> ${getText(b.rich_text)}\\n\\n`;\n    case 'quote': return `> ${getText(b.rich_text)}\\n\\n`;\n    case 'callout': return `> 💡 ${getText(b.rich_text)}\\n\\n`;\n    case 'code': return `\\`\\`\\`${b.language || ''}\\n${getText(b.rich_text)}\\n\\`\\`\\`\\n\\n`;\n    case 'divider': return `---\\n\\n`;\n    case 'image': {\n      const url = b.external?.url || b.file?.url || '';\n      const caption = getText(b.caption) || 'image';\n      return `![${caption}](${url})\\n\\n`;\n    }\n    case 'bookmark': return `[${getText(b.caption) || b.url}](${b.url})\\n\\n`;\n    case 'child_page': return `📄 [${b.title}](./${pageData.title}/${b.title}.md)\\n\\n`;\n    case 'child_database': return `🗄️ [${b.title}](./${pageData.title}/${b.title}/)\\n\\n`;\n    case 'table_of_contents': return `<!-- TOC -->\\n\\n`;\n    default: return '';\n  }\n}\n\nconst blocks = blocksData.results || [];\nlet md = `# ${pageData.title}\\n\\n`;\nmd += `> Last edited: ${pageData.lastEditedTime}\\n> Notion URL: ${pageData.url}\\n\\n---\\n\\n`;\n\nfor (const block of blocks) {\n  md += blockToMarkdown(block);\n}\n\n// File path: top-level = root of repo\nconst filePath = `${pageData.title}.md`;\n\nreturn [{\n  json: {\n    ...pageData,\n    markdown: md,\n    filePath: filePath,\n    commitMessage: `backup: update ${pageData.title}`\n  }\n}];"
      },
