    {
      "parameters": {
        "jsCode": "// Prepare the payload for GitHub create/update file API\nconst fileData = $('Batch (3 at a time)').item.json;\nconst shaResponse = $input.item.json;\n\n// Base64 encode the markdown content\nconst content = Buffer.from(fileData.markdown, 'utf8').toString('base64');\n\n// If file exists, sha is required to update\nconst sha = shaResponse?.sha || null;\n\nreturn [{\n  json: {\n    ...fileData,\n    base64Content: content,\n    existingSha: sha,\n    commitMessage: `n8n backup for changes dated ${fileData.lastEditedTime?.slice(0, 10)}`\n  }\n}];"
      },
