# Copy to .env and fill in real values. .env is gitignored.

# LINE Messaging recipients
TESTUSER=
AUDIENCE=

# n8n credential encryption key
# Locally: pulled from `~/.n8n/config` inside the running n8n container.
# In Cloud Run: bound from Secret Manager.
# Must match the key used when credentials.json was exported.
N8N_ENCRYPTION_KEY=
